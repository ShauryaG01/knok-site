      <section class="section-4 ">
        <div class="section-container ">
          <div class="section-4-heading">Industry Focus</div>
          <div class="group-distri-image">
            <img src="src/image/industry_focus.svg" alt="My Happy SVG" />
          </div>
        </div>
      </section>
      <section class="section-4a reveal active">
        <div class="section-container">
          <div class="section-4-heading">Industry Focus</div>
          <ul>
            <li>
              <span> 1</span> FMCG - Order fulfillment, Warehousing, Logistics,
              Collections, Analytics
            </li>
            <li>
              <span> 2</span> Dairy,Meat & Seafood - Refrigeration, Storage,
              Inventory, Logistics
            </li>
            <li>
              <span> 3</span> White Goods - Logistics, Storage, Tracking,
              Compliance
            </li>
            <li>
              <span> 4</span> E-Commerce - Warehousing, Logistics, Tracking,
              Invoicing
            </li>
            <li>
              <span> 5</span> B2B/B2C Retailers - End-to-end Supply Chain
              Solutioning
            </li>
            <li>
              <span> 6</span> Perishables - Logistics, Storage, Tracking,
              Compliance
            </li>
          </ul>
        </div>
      </section>
      <div class="section-container reveal active">
        <div class="section-2-heading">
          Determined to built India’s first
          <br />
          Plug and Play Distribution Model
        </div>
        <div class="group-distri-image">
          <img src="src/image/section2group.svg" alt="My Happy SVG" />
        </div>
      </div>
    </div>
