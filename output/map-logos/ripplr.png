  <section class="section-1">
    <div class="section-container">
      <div class="section-1-row">
        <div class="future-distribution">
          <div class="section-1-heading">
            Join us in shaping the future <br />
            of Distribution and Logistics
          </div>
          <p class="section-1-desc">
            Building India’s largest digital first distribution platform.
          </p>
          <br />
          <br />
          <div class="in-enquire-now">
            <!-- <a class="actionBtn" href="#enquirenow">Enquire Now</a> -->
            <img src="src/image/home-5-icons.svg" alt="My Happy SVG" />
          </div>
        </div>
        <div class="future-distribution-image">
          <img src="src/image/distribution-eco-system.svg" alt="My Happy SVG" />
        </div>
      </div>
    </div>
    <!-- Home Form Starts Here -->
    <div id="home-tab-forms">
      <div class="tab-containers" id="enquirenow">
        <nav>
          <div class="nav nav-tabs ripplr-d" id="nav-tab" role="tablist">
            <button class="nav-link active" id="nav-home-tab" data-bs-toggle="tab" data-bs-target="#nav-home"
              type="button" role="tab" aria-controls="nav-home" aria-selected="true">
              Distribution
            </button>
            <button class="nav-link" id="nav-profile-tab" data-bs-toggle="tab" data-bs-target="#nav-profile"
              type="button" role="tab" aria-controls="nav-profile" aria-selected="false">
              Logistics
            </button>
          </div>
        </nav>
        <div class="tab-content" id="nav-tabContent">
          <div class="tab-pane fade show active" id="nav-home" role="tabpanel" aria-labelledby="nav-home-tab">
            <form class="requires-validation new-inline-forms" novalidate id="distribution">
              <div class="form-row">
                <input type="text" id="full_name" required class="form-control" placeholder="Full Name*" />
                <input type="number" class="form-control" id="mobile_number"
                  onKeyPress="if(this.value.length==10) return false;" required placeholder="Mobile No*" />
              </div>
              <div class="form-row">
                <input type="email" class="form-control" id="email" placeholder="Email" />
                <input type="message" class="form-control" id="message" required placeholder="Brand Name*" />
              </div>
              <button type="submit" class="btn action-btn btn-default btn-submit">
                Submit
              </button>
            </form>
          </div>
          <div class="tab-pane fade" id="nav-profile" role="tabpanel" aria-labelledby="nav-profile-tab">
            <form class="requires-validation new-inline-forms" novalidate id="logistics">
              <div class="form-row">
                <input type="text" id="l_full_name" required onkeydown="return /[a-z]/i.test(event.key)" maxlength="32"
                  class="form-control" placeholder="Full Name*" />
                <input type="number" class="form-control" id="l_mobile_number"
                  onKeyPress="if(this.value.length==10) return false;" required placeholder="Mobile No*" />
              </div>
              <div class="form-row">
                <input type="text" id="l_from" required class="form-control" placeholder="From *"
                  onkeydown="return /[a-z]/i.test(event.key)" maxlength="32" />
                <input type="text" id="l_to" required class="form-control" placeholder="To *"
                  onkeydown="return /[a-z]/i.test(event.key)" />
              </div>
              <div class="form-row">
                <select class="form-select" required id="l_product_type" aria-label="Default select example"
                  placeholder="Product Type*">
                  <option selected disabled value="">Select type</option>
                  <option value="Document">Document</option>
                  <option value="FMCG">FMCG</option>
                  <option value="Logistic">Apparel</option>
                  <option value="Electronics">Electronics</option>
                  <option value="Food">Food</option>
                  <option value="Furniture">Furniture</option>
                  <option value="Others">Others</option>
                </select>
                <input type="number" min="1" max="9999" id="l_weight"
                  onKeyPress="if(this.value.length==4) return false;" required class="form-control"
                  placeholder="Weight (in Kg)*" />
              </div>
              <div class="form-row">
                <select class="form-select" required id="l_company" aria-label="Default select example"
                  placeholder="Company**">
                  <option selected disabled value="">Select Company</option>
                  <option value="Document">Company</option>
                  <option value="FMCG">Individual</option>
                </select>
              </div>
              <button type="submit" class="btn action-btn btn-default btn-submit">
                Submit
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <!-- Home Form Ends Here -->
  </section>
