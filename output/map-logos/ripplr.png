  <section class="section-3">
    <div class="reveal active">
      <div class="section-container ">
        <div class="section-2-heading ">Our Distribution Services</div>
        <div class="section-3-row">
          <div class="onboard-list">
            <div class="onboarding-data">
              <ul>
                <li>Brand Onboarding</li>
                <li>Supplier Onboarding</li>
                <li>Warehouse Onboarding</li>
                <li>Store Onboarding (Web, Excel Upload, and Salesman App )</li>
              </ul>
              <div class="">
                <img src="src/image/brandgroup.svg" alt="My Happy SVG" />
              </div>
            </div>
            <div class="product-data">
              <ul>
                <li>Product Management</li>
                <li>Price Management</li>
                <li>Special Rate Card Management</li>
                <li>Scheme Management</li>
              </ul>
              <div class="">
                <img src="src/image/prodduct_dist.svg" alt="My Happy SVG" />
              </div>
            </div>
            <div class="procurement-data">
              <ul>
                <li>Purchase order Management</li>
                <li>Goods Receive Note Management</li>
                <li>Purchase Return Management</li>
                <li>Debit Note Management</li>
              </ul>
              <div class="">
                <img src="src/image/procurement_dist.svg" alt="My Happy SVG" />
              </div>
            </div>
            <div class="last-mile-data">
              <ul>
                <li>Vehicle Dispatch Process</li>
                <li>
                  Delivery App (Delivered, Partial Delivery, Order Cancellation,
                  Delivery Attempt, Payment Collections)
                </li>
                <li>Delivery Return Management</li>
              </ul>
              <div class="">
                <img src="src/image/last-mile.svg" alt="My Happy SVG" />
              </div>
            </div>
            <div class="payment-data">
              <ul>
                <li>Payment Collections</li>
                <li>Outstanding</li>
                <li>Payment Settlement</li>
              </ul>
              <br />

              <div class="">
                <img src="src/image/payment.svg" alt="My Happy SVG" />
              </div>
            </div>
          </div>
          <div class="distribution-service-logistic distribution-service">
            <div class="onboarding active">Onboarding Management</div>
            <div class="distribution-product">Product Scheme Management</div>
            <div class="distribution-procurement">Procurement</div>
            <div class="distribution-last-mile">Last Mile</div>
            <div class="distribution-payment">Payment Management</div>
          </div>
        </div>
      </div>
    </div>
  </section>
